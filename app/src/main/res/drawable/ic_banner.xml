    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- 深色圆角背景 -->
    <path
        android:fillColor="#0C0E13"
        android:pathData="M8,0 H312 A8,8 0 0 1 320,8 V172 A8,8 0 0 1 312,180 H8 A8,8 0 0 1 0,172 V8 A8,8 0 0 1 8,0 Z" />

    <!-- Logo：红色圆角方块（居中偏左） -->
    <path
        android:fillColor="#E11D48"
        android:pathData="M28,45 h104 a16,16 0 0 1 16,16 v58 a16,16 0 0 1 -16,16 H28 a16,16 0 0 1 -16,-16 V61 a16,16 0 0 1 16,-16 Z" />

    <!-- 播放三角（白色） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,62 L92,79 L44,96 Z" />

    <!-- 应用名 "TV"（白色，path 绘制，右侧） -->
